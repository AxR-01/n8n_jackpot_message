    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst game = data.gameDescription;\nconst drawDate = data.drawDate;\nconst savedDate = data.saved_date;\n\nconst jackpotMillions =\n  data.announcedFirstRankPrize.amount.value;\n\nconst today = new Date().toLocaleDateString('en-CA', {\n  timeZone: 'Europe/Vienna'\n});\n\nconst isDrawToday = drawDate === today;\nconst drawDateChanged = drawDate !== savedDate;\n\nlet event = 'none';\nlet shouldSend = false;\nlet message = '';\n\nif (isDrawToday) {\n  event = 'drawToday';\n  shouldSend = true;\n\n  message =\n    `🎰 ${game}\\n\\n` +\n    `Heute ist Ziehung!\\n` +\n    `Jackpot: ${jackpotMillions} Mio. €`;\n\n} else if (drawDateChanged) {\n  event = 'newJackpot';\n  shouldSend = true;\n\n  message =\n    `🎰 ${game}\\n\\n` +\n    `Neuer Jackpot: ${jackpotMillions} Mio. €\\n` +\n    `Nächste Ziehung: ${drawDate}`;\n}\n\nreturn [\n  {\n    json: {\n      game: data.game,\n      gameLabel: game,\n      drawDate,\n      savedDate,\n      jackpotMillions,\n      isDrawToday,\n      drawDateChanged,\n      event,\n      shouldSend,\n      message,\n      rowId: data.id\n    }\n  }\n];"
